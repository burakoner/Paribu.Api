<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Paribu.Api</PackageId>
		<Authors>Burak Öner</Authors>
		<Version>2.0.0</Version>
		<FileVersion>2.0.0</FileVersion>
		<PackageVersion>2.0.0</PackageVersion>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<Description>Paribu API Wrapper. Up-to-date, most-complete, well-organized, well-documented, easy-to-use, multi-task and multi-thread compatible Paribu Cryptocurrency Exchange Rest and Websocket Api Wrapper</Description>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageTags>Paribu;Api;Net;Paribu.Api;Paribu.Net;OKX;OKEX;Binance;BNB;BTC;Api;Client;Rest;Web;Websocket;Socket;Wrapper;Crypto;Currency;Cryptocurrency;Exchange;Trade;Trading;Bitcoin;Spot;Margin;Futures;Derivates;Stock;Options;Swap;</PackageTags>
		<PackageReleaseNotes>
			Version 2.0.0 - 18 Oct 2025
		</PackageReleaseNotes>
		<PackageProjectUrl>https://github.com/burakoner/Paribu.Api</PackageProjectUrl>
		<RepositoryUrl>https://github.com/burakoner/Paribu.Api</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>Paribu.png</PackageIcon>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Paribu.png" Pack="true" PackagePath="\" />
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="ApiSharp" Version="4.1.0" />
	</ItemGroup>

</Project>
